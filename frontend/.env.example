# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser —
# never put secrets in them.

# Public URL of the deployed site (used for canonical URLs / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact channels shown across the site
NEXT_PUBLIC_CONTACT_EMAIL=hello@riyadvisoftwaretechnologies.com
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle

# Express backend (server-side only; used by the /api rewrite added in Step 6)
BACKEND_URL=http://localhost:5000

# Content source for pages: "local" (bundled src/data) or "api" (Express/MongoDB with
# ISR + local fallback). Use "api" in production so new DB records go live without a redeploy.
CONTENT_SOURCE=local

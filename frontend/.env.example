# Copy to .env (or .env.local) and fill in. NEXT_PUBLIC_* values are exposed to the browser —
# never put secrets in them.

# Public URL of the deployed site (used for canonical URLs / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact channels shown across the site
NEXT_PUBLIC_CONTACT_EMAIL=hello@riyadvisoftwaretechnologies.com
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle

# Content source for pages: "local" (bundled src/data) or "api" (MongoDB with ISR +
# local fallback). Use "api" in production so new DB records go live without a redeploy.
CONTENT_SOURCE=local

# ── Server-only (API Route Handlers in src/app/api). Secrets — never prefix with NEXT_PUBLIC_ ──

# MongoDB — local:  mongodb://127.0.0.1:27017/riyadvi
#           Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/riyadvi
MONGODB_URI=mongodb://127.0.0.1:27017/riyadvi

# Admin dashboard
ADMIN_EMAIL=admin@example.com
# Admin password (plain). Optional stronger alternative: replace it with
# ADMIN_PASSWORD_HASH=<output of: npm run hash-password -- "<password>">
ADMIN_PASSWORD=
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Email notifications (optional — leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Riyadvi Website <no-reply@riyadvisoftwaretechnologies.com>"
NOTIFY_TO=hello@riyadvisoftwaretechnologies.com
GUIDE_DOWNLOAD_URL=/downloads/riyadvi-software-project-planning-guide.pdf
